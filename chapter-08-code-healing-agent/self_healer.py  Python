import os
import subprocess
import tempfile
from dotenv import load_dotenv
import anthropic

load_dotenv()
client = anthropic.Anthropic(api_key=os.getenv("ANTHROPIC_API_KEY"))

BROKEN_CODE = """
def calculate_average(nums):
    return sum(nums) / len(nums)

# Intentional error: empty list division
print(calculate_average([]))
"""

def execute_code(code_str: str):
    with tempfile.NamedTemporaryFile(suffix=".py", mode="w+", delete=False) as f:
        f.write(code_str)
        f.flush()
        result = subprocess.run(["python", f.name], capture_output=True, text=True)
    os.remove(f.name)
    return result.returncode, result.stderr

def repair_loop(broken_code: str):
    code = broken_code
    for attempt in range(1, 3):
        returncode, stderr = execute_code(code)
        if returncode == 0:
            print("[SUCCESS] Code executed with zero errors!")
            return code
        
        print(f"[ATTEMPT {attempt} FAILED]:\n{stderr.strip()}")
        
        prompt = f"Fix this Python code so it handles errors safely without crashing:\n```python\n{code}\n```\nError trace:\n{stderr}\nOutput only valid Python code inside ```python blocks."
        res = client.messages.create(
            model="claude-3-5-sonnet-latest",
            max_tokens=512,
            messages=[{"role": "user", "content": prompt}]
        )
        reply = res.content[0].text
        code = reply.split("```python")[1].split("```")[0].strip()

    return code

if __name__ == "__main__":
    repair_loop(BROKEN_CODE)
